# ==============================================================================
# CAVIA MUSIC — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' or configure via Flutter compile-time defines:
#   flutter run --dart-define=CAVIA_SUPABASE_URL=... --dart-define=CAVIA_SUPABASE_ANON_KEY=...
# ==============================================================================

# Application Environment (development, staging, production)
CAVIA_APP_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE BACKEND (Authentication & Outbox Cloud Synchronization)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
CAVIA_SUPABASE_URL=https://your-project-id.supabase.co
CAVIA_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# SPOTIFY DEVELOPER INTEGRATION (OAuth PKCE & Metadata Ingestion)
# ------------------------------------------------------------------------------
# Found in Spotify Developer Dashboard -> Your App -> Basic Information
# NOTE: Never put client_secret in client-side applications. Cavia uses PKCE.
CAVIA_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
CAVIA_SPOTIFY_REDIRECT_URI=cavia://spotify-callback

# Optional desktop local loopback callback (Windows / Linux desktop fallback)
CAVIA_SPOTIFY_DESKTOP_REDIRECT_URI=http://localhost:8888/callback

# ------------------------------------------------------------------------------
# STORAGE & OFFLINE CACHING LIMITS
# ------------------------------------------------------------------------------
# Default is 1.2 GB (1,288,490,188 bytes)
CAVIA_MAX_CACHE_SIZE_BYTES=1288490188

# ------------------------------------------------------------------------------
# LOGGING & DIAGNOSTICS
# ------------------------------------------------------------------------------
# Set to 'true' to enable sanitized, redacted console output during development
CAVIA_ENABLE_CONSOLE_LOGS=false

